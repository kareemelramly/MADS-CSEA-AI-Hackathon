# Copy to .env (never commit .env). Every value below is a placeholder or a default.

# Optional: with an NVIDIA GPU and the NVIDIA Container Toolkit, uncomment so plain `docker compose up` uses the GPU.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Values marked ASSUMPTION are planning values fixed before any run; do not change them after seeing results.

# ---- Model: one local llama.cpp server, open-weight GGUF only. No API keys, no hosted model.
LOCAL_BASE_URL=http://llm:8080/v1
# Default (CPU-friendly, ~2.5 GB): Qwen3 4B Instruct 2507. GPU option: gemma-4-26b-a4b-it-q4_k_m (docker-compose.gpu.yml).
LOCAL_MODEL=qwen3-4b-instruct-2507-q4_k_m
# Folder that holds the GGUF file (mounted read-only into the llm container). With the file present nothing is downloaded.
LOCAL_MODEL_DIR=./models
LOCAL_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LOCAL_MODEL_HF=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
LOCAL_CTX=8192
LLAMA_ARGS_EXTRA=

# ---- Limits (ASSUMPTION until measured)
LLM_MAX_TOKENS=2000
LLM_LOCAL_TIMEOUT_S=300
LLM_MAX_ATTEMPTS_PER_CALL=4
LLM_MIN_ATTEMPT_S=5
LLM_COOLDOWN_DEFAULT_S=60
LLM_TIMEOUT_COOLDOWN_S=30
WORKFLOW_TIME_BUDGET_S=1800
# 0 = off.
RUN_TIME_BUDGET_S=0

# ---- Gate thresholds (ASSUMPTION, locked before the first real run)
DISCOVER_MIN_SOURCES_OK=2
DISCOVER_MIN_ITEMS_SCREENED=20
DISCOVER_MIN_RELEVANT=3
DISCOVER_MIN_FIT=3.0
VALIDATE_TARGET_SIGNUPS=100
VALIDATE_TARGET_DAYS=14
VALIDATE_MIN_VISITORS=200
VALIDATE_REPEAT_FLOOR=0.5
VALIDATE_MAX_ATTEMPTS=2
MAX_BUILD_ATTEMPTS=3

# ---- MOCKED ledger (no payment of any kind runs)
MOCK_FEE_RATE=0.05
MOCK_TOKEN_EXPIRY_HOURS=24
