<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ c.headline }}</title>
<style>
*{box-sizing:border-box}
body{margin:0;font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;color:#1d1f1a;background:#fbfaf6}
.wrap{max-width:880px;margin:0 auto;padding:0 24px}
.banner{background:#fff3d6;border-bottom:1px solid #e0b84a;color:#7a5a00;font-weight:600;text-align:center;padding:8px;font-size:.85rem;letter-spacing:.04em}
.label{display:inline-block;border:1px solid #b45309;color:#b45309;padding:3px 8px;border-radius:3px;font:600 .72rem/1.2 ui-monospace,Menlo,monospace;letter-spacing:.08em}
header.hero{padding:64px 0 48px;border-bottom:1px solid #d8d4c6}
h1{font:600 2.6rem/1.12 Georgia,"Times New Roman",serif;margin:18px 0 14px;max-width:16em}
.sub{font-size:1.15rem;color:#4a4a42;max-width:36em;margin:0 0 28px}
.cta{display:inline-block;background:#1d1f1a;color:#fbfaf6;padding:13px 22px;border-radius:4px;text-decoration:none;font-weight:600}
section{padding:44px 0;border-bottom:1px solid #d8d4c6}
h2{font:600 1.5rem/1.2 Georgia,serif;margin:0 0 20px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;list-style:none;padding:0;margin:0}
.cards li{background:#fff;border:1px solid #d8d4c6;border-radius:6px;padding:18px}
.cards small,.cards em{display:block;margin-top:10px;color:#6b6a60;font-size:.8rem}
.cards a{color:#1d4f91}
form{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
input[type=email]{flex:1 1 260px;padding:12px 14px;border:1px solid #b9b5a6;border-radius:4px;font-size:1rem;background:#fff}
button{background:#1d1f1a;color:#fbfaf6;border:0;border-radius:4px;padding:13px 22px;font-weight:600;font-size:1rem;cursor:pointer}
.note{flex-basis:100%;font-size:.85rem;color:#6b6a60;margin:6px 0 0}
details{background:#fff;border:1px solid #d8d4c6;border-radius:6px;padding:14px 18px;margin-bottom:10px}
summary{font-weight:600;cursor:pointer}
details p{margin:10px 0 0;color:#4a4a42}
footer{color:#6b6a60;font-size:.8rem;padding:28px 0 48px}
@media (max-width:600px){h1{font-size:2rem}}
</style></head>
<body>
{% if override %}<div class="banner">UNVALIDATED · FOUNDER OVERRIDE</div>{% endif %}
<div class="wrap">
<header class="hero">
<p><span class="label">DRAFT · STUBBED · NOT PUBLISHED</span></p>
<h1>{{ c.headline }}</h1>
<p class="sub">{{ c.subheadline }}</p>
<a class="cta" href="#waitlist">{{ c.cta }}</a>
</header>
<section>
<h2>Why {{ product }}</h2>
<ul class="cards">
{% for b in benefits %}<li>{{ b.text }}{% if b.assumption %} <em>(ASSUMPTION)</em>{% else %} <small>Evidence: {% for sid, url in b.links %}<a href="{{ url }}">{{ sid }}</a> {% endfor %}</small>{% endif %}</li>
{% endfor %}</ul>
</section>
<section id="waitlist">
<h2>Join the waitlist</h2>
<form action="#waitlist-mock" method="post" onsubmit="return false;">
  <label for="email" class="note" style="flex-basis:auto;margin:0">Email</label>
  <input id="email" type="email" name="email" required placeholder="you@example.com">
  <button type="submit">{{ c.cta }}</button>
  <p class="note"><span class="label">Waitlist: MOCKED</span> This form submits nowhere. Only an email would be asked for; no password or payment field exists.</p>
</form>
</section>
<section>
<h2>FAQ</h2>
{% for f in c.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
{% endfor %}
</section>
<footer>Waitlist: MOCKED · Draft generated by run {{ run_id }} for founder review. No income or results are promised.</footer>
</div>
</body></html>
