<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>{{ c.headline }}</title>
<style>body{font-family:system-ui,sans-serif;max-width:720px;margin:2rem auto;padding:0 1rem;color:#1f2937}
.label{background:#fff3e0;color:#b45309;padding:2px 6px;border-radius:4px;font-size:.8rem}
.banner{background:#fef3c7;border:1px solid #f59e0b;padding:.5rem;margin-bottom:1rem}
footer{color:#64748b;font-size:.8rem;margin-top:2rem}</style></head>
<body style="background:#ffffff;color:#1f2937">
{% if override %}<div class="banner">UNVALIDATED · FOUNDER OVERRIDE</div>{% endif %}
<p><span class="label">DRAFT · STUBBED · NOT PUBLISHED</span></p>
<h1>{{ c.headline }}</h1>
<p>{{ c.subheadline }}</p>
<h2>Why {{ product }}</h2>
<ul>
{% for b in benefits %}<li>{{ b.text }}{% if b.assumption %} <em>(ASSUMPTION)</em>{% else %} <small>Evidence: {% for sid, url in b.links %}<a href="{{ url }}">{{ sid }}</a> {% endfor %}</small>{% endif %}</li>
{% endfor %}</ul>
<h2>Join the waitlist</h2>
<form action="#waitlist-mock" method="post" onsubmit="return false;">
  <label>Email <input type="email" name="email" required></label>
  <button type="submit">{{ c.cta }}</button>
  <p><span class="label">Waitlist: MOCKED</span> This form submits nowhere. Only an email would be asked for; no password or payment field exists.</p>
</form>
<h2>FAQ</h2>
<dl>{% for f in c.faq %}<dt>{{ f.q }}</dt><dd>{{ f.a }}</dd>{% endfor %}</dl>
<footer>Waitlist: MOCKED · Draft generated by run {{ run_id }} for founder review. No income or results are promised.</footer>
</body></html>
